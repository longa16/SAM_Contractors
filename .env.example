# Ne jamais versionner .env ni y copier des secrets dans des documents.
SAM_API_KEY=
GROQ_API_KEY=
# Le chemin par défaut est absolu, sous data/ dans le checkout.
DATABASE_URL=sqlite:///data/app.db
LOG_LEVEL=INFO
SAM_TIMEOUT_SECONDS=60
SAM_RETRY_ATTEMPTS=3
SAM_RETRY_WAIT_SECONDS=1
SAM_PAGE_SIZE=1000
SAM_MAX_PAGES=50
SAM_WINDOW_DAYS=365
SAM_USER_AGENT=GovContractAI/0.1
SYNC_LOCK_MINUTES=30
SYNC_CRON_HOURS=0,8,16
SYNC_CATCHUP_HOURS=8
RETENTION_DAYS=30
SCREENING_STAGE1_THRESHOLD=40
SCREENING_STAGE2_DAILY_CAP=100
LLM_MODEL=llama-3.3-70b-versatile

# Requis pour ouvrir une session ; générer une valeur aléatoire privée >= 32 caractères.
JWT_SECRET=
JWT_EXPIRY_MINUTES=30
JWT_ISSUER=govcontractai
MAX_DESC_CHARS=24000
LLM_TIMEOUT_SECONDS=60
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_MAX_TOKENS=2000
LLM_FAILURE_LIMIT=5
LLM_CIRCUIT_SECONDS=60
LLM_RETRY_ATTEMPTS=3

# Initialisation automatique unique, puis synchronisations manuelles.
AUTO_INITIAL_SYNC=true
SCHEDULED_SYNC_ENABLED=false
BOOTSTRAP_CHUNK_DAYS=7
